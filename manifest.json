{
  "manifest_version": 3,
  "name": "Dev Toolbox",
  "version": "2.1.0",
  "description": "Jump between environments of the same app (Prod, QA, Staging, Local) from the right-click menu or toolbar, and copy the app's MSAL bearer token for Postman.",
  "permissions": ["contextMenus", "storage", "activeTab", "scripting"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Dev Toolbox",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
